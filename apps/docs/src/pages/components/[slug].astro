---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { components, categoryLabel } from '../../lib/data';
import { examplesFor } from '../../lib/examples';
import { editorial } from '../../lib/editorial';
import ReactDemo from '../../components/ReactDemo';
import VueDemo from '../../components/VueDemo.vue';

export const getStaticPaths = (() =>
  components.map((c) => ({ params: { slug: c.slug }, props: { c } }))) satisfies GetStaticPaths;

const { c } = Astro.props;
const examples = examplesFor(c.slug);
const note = editorial[c.slug];
const nameOf = (slug: string) => components.find((x) => x.slug === slug)?.name ?? slug;

const hasGuidance = Boolean(note && (note.instead || note.rules));
const toc = [
  ...(hasGuidance ? [{ id: 'guia', label: 'Cuándo usarlo' }] : []),
  ...(examples.length > 0 ? [{ id: 'ejemplos', label: 'Ejemplos' }] : []),
  { id: 'uso', label: 'Uso' },
  { id: 'anatomia', label: 'Anatomía' },
  { id: 'props', label: 'Props' },
  { id: 'accesibilidad', label: 'Accesibilidad' },
];

/** Cómo se escribe la prop en Vue cuando difiere del contrato. */
function vueSpelling(status: string): string {
  if (status.startsWith('alias:')) return `v-model (${status.slice(6)})`;
  if (status === 'exception') return 'atributo nativo o prop de la parte';
  return 'igual';
}
---

<Base
  title={c.name}
  current={c.slug}
  side
  crumbs={[{ label: 'Componentes', href: '/components/' }, { label: c.name }]}
  toc={toc}
>
  <h1>{c.name}</h1>
  <p class="lead">{note?.use ?? `Componente de ${categoryLabel(c.category).toLowerCase()}.`}</p>
  <ul class="badges">
    <li>{categoryLabel(c.category)}</li>
    <li>{c.tier}</li>
    <li>{c.engine === 'zag' ? 'Motor Zag.js' : 'Nativo'}</li>
    <li>Vue {c.frameworks.vue ? '✓' : '✗'}</li>
    <li>React {c.frameworks.react ? '✓' : '✗'}</li>
    <li><a href={c.apgPattern}>Patrón WAI-ARIA</a></li>
    <li><a href={`/components/${c.slug}.json`}>JSON</a></li>
    <li class="go"><a href={`/playground/#c=${c.slug}`} data-playground>Abrir en Playground</a></li>
  </ul>

  {
    hasGuidance && note && (
      <>
        <h2 id="guia">Cuándo usarlo</h2>
        {note.instead && (
          <ul>
            {note.instead.map(([slug, why]) => (
              <li>
                Usa <a href={`/components/${slug}/`}>{nameOf(slug)}</a> cuando: {why}
              </li>
            ))}
          </ul>
        )}
        {note.rules && (
          <>
            <h3>Recomendaciones</h3>
            <ul>
              {note.rules.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </>
        )}
      </>
    )
  }

  {
    examples.length > 0 && (
      <>
        <h2 id="ejemplos">Ejemplos</h2>
        {examples.map((e) => (
          <section class="example" aria-label={e.id}>
            <h3>{e.id}</h3>
            <div class="code-pair">
              <div class="frame" data-fw="vue">
                <div class="demo">
                  <VueDemo client:visible slug={c.slug} id={e.id} />
                </div>
                <details>
                  <summary>
                    <span class="fw-dot" data-for="vue" />
                    Vue
                    <em>Código</em>
                  </summary>
                  <pre><code>{e.vue}</code></pre>
                </details>
              </div>
              <div class="frame" data-fw="react">
                <div class="demo">
                  <ReactDemo client:visible slug={c.slug} id={e.id} />
                </div>
                <details>
                  <summary>
                    <span class="fw-dot" data-for="react" />
                    React
                    <em>Código</em>
                  </summary>
                  <pre><code>{e.react}</code></pre>
                </details>
              </div>
            </div>
          </section>
        ))}
      </>
    )
  }

  <h2 id="uso">Uso</h2>
  <div class="code-pair">
    <div data-fw="vue">
      <h3>Vue · <code>{c.names.vue}</code></h3>
      <pre><code>{c.example.vue}</code></pre>
    </div>
    <div data-fw="react">
      <h3>React · <code>{c.names.react}</code></h3>
      <pre><code>{c.example.react}</code></pre>
    </div>
  </div>

  <h2 id="anatomia">Anatomía</h2>
  <ul class="badges">
    {
      c.anatomy.map((p) => (
        <li>
          <code>{p}</code>
        </li>
      ))
    }
  </ul>
  {
    c.parts.react.length > 0 && (
      <p>
        Partes compuestas: {c.parts.react.map((p) => <code>{p} </code>)}. En Vue llevan el prefijo{' '}
        <code>T</code>.
      </p>
    )
  }

  <h2 id="props">Props</h2>
  <div class="table-scroll">
  <table class="api">
    <thead>
      <tr>
        <th scope="col">Prop</th><th scope="col">Tipo</th><th scope="col">Por defecto</th><th
          scope="col">Vue</th
        >
      </tr>
    </thead>
    <tbody>
      {
        c.props.map((p) => (
          <tr>
            <th scope="row">
              <code>{p.name}</code>
            </th>
            <td>
              {p.type === 'enum' ? (
                p.values!.map((v) => <code>{v} </code>)
              ) : (
                <code>{p.type}</code>
              )}
            </td>
            <td>{p.default === undefined ? '—' : <code>{String(p.default)}</code>}</td>
            <td>{vueSpelling(p.vue)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>

  <h2 id="accesibilidad">Comportamiento y accesibilidad</h2>
  <p>Cada línea es una prueba que se ejecuta contra el componente de Vue y el de React. Los enunciados de las pruebas se mantienen en inglés.</p>
  <ul class="checks">
    {c.behaviours.map((b) => <li>{b.describe}</li>)}
  </ul>
</Base>

<script>
  // El enlace lleva el framework que el lector eligió arriba: abre la pestaña de código correcta.
  const link = document.querySelector<HTMLAnchorElement>('[data-playground]');
  link?.addEventListener('click', () => {
    const fw = document.documentElement.dataset.fw;
    const base = (link.getAttribute('href') ?? '').split('&')[0] ?? '';
    link.href = fw === 'vue' || fw === 'react' ? `${base}&fw=${fw}` : base;
  });
</script>
