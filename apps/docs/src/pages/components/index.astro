---
import Base from '../../layouts/Base.astro';
import { byCategory, categoryLabel } from '../../lib/data';
---

<Base title="Componentes" current="components">
  <h1>Componentes</h1>
  <p class="lead">Todos los componentes, agrupados por categoría. Vue y React comparten un mismo contrato.</p>
  {
    byCategory().map(([category, list]) => (
      <section>
        <h2>{categoryLabel(category)}</h2>
        <ul class="cards">
          {list.map((c) => (
            <li>
              <a href={`/components/${c.slug}/`}>
                {c.name}
                <small>
                  {c.tier} · {c.engine} · {c.props.length} props
                </small>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
