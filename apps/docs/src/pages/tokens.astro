---
import Base from '../layouts/Base.astro';
import {
  colorScales,
  cssVar,
  dim,
  durations,
  easings,
  elevations,
  fontFamilies,
  radii,
  semanticColors,
  spacing,
  typography,
  typographyVar,
} from '../lib/tokens';

const sections = [
  ['color', 'Color'],
  ['typography', 'Tipografía'],
  ['spacing', 'Espaciado'],
  ['radius', 'Radio'],
  ['elevation', 'Elevación'],
  ['motion', 'Movimiento'],
] as const;
---

<Base title="Tokens" current="tokens" description="Tokens de diseño: color, tipografía, espaciado, radio, elevación y movimiento.">
  <h1>Tokens</h1>
  <p class="lead">
    Cada valor es una propiedad CSS personalizada con prefijo <code>--tessen-</code>. Los roles
    semánticos cambian con el tema; usa el interruptor de la cabecera para verlos cambiar. Haz clic
    en el nombre de una muestra para copiar su variable.
  </p>
  <nav class="toc" aria-label="En esta página">
    {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <section id="color">
    <h2>Color</h2>
    <h3>Roles semánticos</h3>
    <p>Úsalos en los componentes. Se resuelven por tema y se comprueba su contraste.</p>
    {
      semanticColors().map(({ group, tokens }) => (
        <>
          <h4>{group}</h4>
          <ul class="swatches">
            {tokens.map((t) => (
              <li>
                <span class="chip" style={`background:var(${cssVar(t)})`} />
                <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
                  {t.path.replace('color.', '')}
                </button>
                {t.description && <small>{t.description}</small>}
              </li>
            ))}
          </ul>
        </>
      ))
    }
    <h3>Escalas primitivas</h3>
    <p>Paleta en bruto. Recurre a ellas solo cuando ningún rol semántico encaje.</p>
    {
      colorScales().map(({ name, steps }) => (
        <>
          <h4>{name}</h4>
          <ul class="scale">
            {steps.map((t) => (
              <li>
                <span class="chip" style={`background:var(${cssVar(t)})`} />
                <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
                  {t.path.split('.').pop()}
                </button>
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </section>

  <section id="typography">
    <h2>Tipografía</h2>
    <h3>Familias</h3>
    <ul class="plain">
      {
        fontFamilies().map((t) => (
          <li style={`font-family:var(${cssVar(t)})`}>
            <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
              {t.path.replace('font.family.', '')}
            </button>
            — El veloz murciélago hindú comía feliz cardillo y kiwi
          </li>
        ))
      }
    </ul>
    <h3>Estilos</h3>
    <ul class="plain">
      {
        typography().map((t) => (
          <li class="type-row">
            <button type="button" class="copy" data-copy={typographyVar(t, 'font-size')}>
              {t.path.replace('typography.', '')}
            </button>
            <span
              style={`font-family:${typographyVar(t, 'font-family')};font-size:${typographyVar(t, 'font-size')};font-weight:${typographyVar(t, 'font-weight')};line-height:${typographyVar(t, 'line-height')};letter-spacing:${typographyVar(t, 'letter-spacing')}`}
            >
              Sistema de diseño Tessen
            </span>
            {t.description && <small>{t.description}</small>}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="spacing">
    <h2>Espaciado</h2>
    <ul class="plain">
      {
        spacing()
          .sort((a, b) => (a.value as { value: number }).value - (b.value as { value: number }).value)
          .map((t) => (
            <li class="bar-row">
              <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
                {t.path.replace('space.', '')}
              </button>
              <code>{dim(t.value)}</code>
              <span class="bar" style={`width:var(${cssVar(t)})`} />
            </li>
          ))
      }
    </ul>
  </section>

  <section id="radius">
    <h2>Radio</h2>
    <ul class="swatches">
      {
        radii().map((t) => (
          <li>
            <span class="chip box" style={`border-radius:var(${cssVar(t)})`} />
            <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
              {t.path.replace('radius.', '')}
            </button>
            <small>{dim(t.value)}</small>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="elevation">
    <h2>Elevación</h2>
    <ul class="swatches">
      {
        elevations().map((t) => (
          <li>
            <span class="chip box" style={`box-shadow:var(${cssVar(t)})`} />
            <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
              {t.path.replace('elevation.', '')}
            </button>
            {t.description && <small>{t.description}</small>}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="motion">
    <h2>Movimiento</h2>
    <p>Pasa el cursor o enfoca una fila para ver la curva. Las duraciones pasan a cero con movimiento reducido.</p>
    <h3>Duración</h3>
    <ul class="plain">
      {
        durations().map((t) => (
          <li class="bar-row">
            <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
              {t.path.replace('motion.duration.', '')}
            </button>
            <code>{dim(t.value)}</code>
          </li>
        ))
      }
    </ul>
    <h3>Curva de easing</h3>
    <ul class="plain">
      {
        easings().map((t) => (
          <li class="ease-row" tabindex="0" style={`--ease:var(${cssVar(t)})`}>
            <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
              {t.path.replace('motion.easing.', '')}
            </button>
            <code>cubic-bezier({(t.value as number[]).join(', ')})</code>
            <span class="track"><span class="dot" /></span>
          </li>
        ))
      }
    </ul>
  </section>

  <script is:inline>
    document.addEventListener('click', (e) => {
      const b = e.target instanceof Element && e.target.closest('[data-copy]');
      if (!b) return;
      const text = b.getAttribute('data-copy');
      const label = b.textContent;
      navigator.clipboard?.writeText(text).then(() => {
        b.textContent = 'Copiado';
        setTimeout(() => (b.textContent = label), 900);
      });
    });
  </script>
</Base>
