---
import Base from '../layouts/Base.astro';
import {
  colorScales,
  cssVar,
  dim,
  durations,
  easings,
  elevations,
  fontFamilies,
  radii,
  semanticColors,
  spacing,
  typography,
  typographyVar,
} from '../lib/tokens';

const sections = [
  ['color', 'Colour'],
  ['typography', 'Typography'],
  ['spacing', 'Spacing'],
  ['radius', 'Radius'],
  ['elevation', 'Elevation'],
  ['motion', 'Motion'],
] as const;
---

<Base title="Tokens" current="tokens" description="Design tokens: colour, type, spacing, radius, elevation and motion.">
  <h1>Tokens</h1>
  <p class="lead">
    Every value is a CSS custom property prefixed <code>--tessen-</code>. Semantic roles change with
    the theme; use the toggle in the header to see them switch. Click a swatch's name to copy its
    variable.
  </p>
  <nav class="toc" aria-label="On this page">
    {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <section id="color">
    <h2>Colour</h2>
    <h3>Semantic roles</h3>
    <p>Use these in components. They resolve per theme and are checked for contrast.</p>
    {
      semanticColors().map(({ group, tokens }) => (
        <>
          <h4>{group}</h4>
          <ul class="swatches">
            {tokens.map((t) => (
              <li>
                <span class="chip" style={`background:var(${cssVar(t)})`} />
                <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
                  {t.path.replace('color.', '')}
                </button>
                {t.description && <small>{t.description}</small>}
              </li>
            ))}
          </ul>
        </>
      ))
    }
    <h3>Primitive scales</h3>
    <p>Raw palette. Reach for these only when no semantic role fits.</p>
    {
      colorScales().map(({ name, steps }) => (
        <>
          <h4>{name}</h4>
          <ul class="scale">
            {steps.map((t) => (
              <li>
                <span class="chip" style={`background:var(${cssVar(t)})`} />
                <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
                  {t.path.split('.').pop()}
                </button>
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </section>

  <section id="typography">
    <h2>Typography</h2>
    <h3>Families</h3>
    <ul class="plain">
      {
        fontFamilies().map((t) => (
          <li style={`font-family:var(${cssVar(t)})`}>
            <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
              {t.path.replace('font.family.', '')}
            </button>
            — The quick brown fox jumps over the lazy dog
          </li>
        ))
      }
    </ul>
    <h3>Styles</h3>
    <ul class="plain">
      {
        typography().map((t) => (
          <li class="type-row">
            <button type="button" class="copy" data-copy={typographyVar(t, 'font-size')}>
              {t.path.replace('typography.', '')}
            </button>
            <span
              style={`font-family:${typographyVar(t, 'font-family')};font-size:${typographyVar(t, 'font-size')};font-weight:${typographyVar(t, 'font-weight')};line-height:${typographyVar(t, 'line-height')};letter-spacing:${typographyVar(t, 'letter-spacing')}`}
            >
              Tessen design system
            </span>
            {t.description && <small>{t.description}</small>}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="spacing">
    <h2>Spacing</h2>
    <ul class="plain">
      {
        spacing()
          .sort((a, b) => (a.value as { value: number }).value - (b.value as { value: number }).value)
          .map((t) => (
            <li class="bar-row">
              <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
                {t.path.replace('space.', '')}
              </button>
              <code>{dim(t.value)}</code>
              <span class="bar" style={`width:var(${cssVar(t)})`} />
            </li>
          ))
      }
    </ul>
  </section>

  <section id="radius">
    <h2>Radius</h2>
    <ul class="swatches">
      {
        radii().map((t) => (
          <li>
            <span class="chip box" style={`border-radius:var(${cssVar(t)})`} />
            <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
              {t.path.replace('radius.', '')}
            </button>
            <small>{dim(t.value)}</small>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="elevation">
    <h2>Elevation</h2>
    <ul class="swatches">
      {
        elevations().map((t) => (
          <li>
            <span class="chip box" style={`box-shadow:var(${cssVar(t)})`} />
            <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
              {t.path.replace('elevation.', '')}
            </button>
            {t.description && <small>{t.description}</small>}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="motion">
    <h2>Motion</h2>
    <p>Hover or focus a row to preview the curve. Durations collapse to zero under reduced motion.</p>
    <h3>Duration</h3>
    <ul class="plain">
      {
        durations().map((t) => (
          <li class="bar-row">
            <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
              {t.path.replace('motion.duration.', '')}
            </button>
            <code>{dim(t.value)}</code>
          </li>
        ))
      }
    </ul>
    <h3>Easing</h3>
    <ul class="plain">
      {
        easings().map((t) => (
          <li class="ease-row" tabindex="0" style={`--ease:var(${cssVar(t)})`}>
            <button type="button" class="copy" data-copy={`var(${cssVar(t)})`}>
              {t.path.replace('motion.easing.', '')}
            </button>
            <code>cubic-bezier({(t.value as number[]).join(', ')})</code>
            <span class="track"><span class="dot" /></span>
          </li>
        ))
      }
    </ul>
  </section>

  <script is:inline>
    document.addEventListener('click', (e) => {
      const b = e.target instanceof Element && e.target.closest('[data-copy]');
      if (!b) return;
      const text = b.getAttribute('data-copy');
      const label = b.textContent;
      navigator.clipboard?.writeText(text).then(() => {
        b.textContent = 'Copied';
        setTimeout(() => (b.textContent = label), 900);
      });
    });
  </script>
</Base>
