  inspect: 'M4 8V4h4M16 4h4v4M4 16v4h4M12 12l8 3-3.5 1.5L15 20l-3-8Z',
} as const;

export type IconName = keyof typeof paths;
interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 18 } = Astro.props;
---

<svg
  class="i"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
