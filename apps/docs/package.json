{
  "name": "@tessen-ui/docs",
  "private": true,
  "version": "0.0.0",
  "description": "Tessen documentation site (Astro). Runs locally only: no hosting, no deploy (ADR 0014).",
  "type": "module",
  "scripts": {
    "generate": "pnpm --filter @tessen-ui/docs-gen run generate",
    "dev": "pnpm generate && astro dev",
    "build": "pnpm generate && astro build",
    "preview": "astro preview",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@astrojs/vue": "7.1.6",
    "@tessen-ui/react": "workspace:*",
    "@tessen-ui/styles": "workspace:*",
    "@tessen-ui/tokens": "workspace:*",
    "@tessen-ui/vue": "workspace:*",
    "astro": "^7.4.13",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tessen-ui/docs-gen": "workspace:*",
    "@tessen-ui/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
