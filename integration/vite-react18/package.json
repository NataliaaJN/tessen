{
  "name": "tessen-integration-vite-react18",
  "private": true,
  "version": "0.0.0",
  "description": "Consumer project (ADR 0016): installs the packed @tessen-ui tarballs like an external React 18.3 + Vite app (version matrix, peer range ^18.3.0). Not part of the workspace.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.nodenext.json",
    "build": "vite build",
    "check": "node scripts/check.mjs",
    "test": "pnpm typecheck && pnpm build && pnpm check"
  },
  "dependencies": {
    "@tessen-ui/core": "*",
    "@tessen-ui/icons": "*",
    "@tessen-ui/motion": "*",
    "@tessen-ui/styles": "*",
    "@tessen-ui/tokens": "*",
    "@tessen-ui/react": "*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
