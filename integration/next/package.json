{
  "name": "tessen-integration-next",
  "private": true,
  "version": "0.0.0",
  "description": "Consumer project (ADR 0016): installs the packed @tessen-ui tarballs like an external Next.js (App Router, SSR) app. Not part of the workspace.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
