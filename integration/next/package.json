  },
  "dependencies": {
    "@tessen-ui/core": "*",
    "@tessen-ui/icons": "*",
    "@tessen-ui/motion": "*",
    "@tessen-ui/styles": "*",
    "@tessen-ui/tokens": "*",
    "@tessen-ui/react": "*",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
