{
  "name": "tessen-integration-vite-vue",
  "private": true,
  "version": "0.0.0",
  "description": "Consumer project (ADR 0016): installs the packed @tessen-ui tarballs like an external Vue + Vite app. Not part of the workspace.",
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.nodenext.json",
    "build": "vite build",
    "check": "node scripts/check.mjs",
    "test": "pnpm typecheck && pnpm build && pnpm check"
  },
  "dependencies": {
    "@tessen-ui/core": "*",
    "@tessen-ui/icons": "*",
    "@tessen-ui/motion": "*",
    "@tessen-ui/styles": "*",
    "@tessen-ui/tokens": "*",
    "@tessen-ui/vue": "*",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
