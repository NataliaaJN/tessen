{
  "extends": "@tessen-ui/tsconfig/node.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "scripts/**/*.ts",
    "harness/**/*.tsx"
  ]
}
