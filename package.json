{
  "name": "tessen",
  "private": true,
  "version": "0.0.0",
  "description": "TESSEN monorepo root (workspace only, never published).",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=12.21.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "tokens:check": "turbo run tokens:check",
    "deps:check": "depcruise --config .dependency-cruiser.cjs tooling packages",
    "scope:check": "node tooling/scripts/scope-check.mjs",
    "parity:api": "node tooling/scripts/parity-api.mjs",
    "docs:check": "pnpm --filter @tessen-ui/docs-gen run check && pnpm --filter @tessen-ui/docs run typecheck",
    "size": "size-limit",
    "licenses:check": "node tooling/scripts/licenses-check.mjs",
    "e2e": "pnpm --filter @tessen-ui/e2e run e2e",
    "ssr:e2e": "node tooling/scripts/ssr-e2e.mjs",
    "docs:smoke": "pnpm --filter @tessen-ui/e2e exec node docs-smoke.mjs",
    "new:component": "node tooling/scripts/new-component.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm tokens:check && pnpm deps:check && pnpm scope:check && pnpm licenses:check && pnpm test && pnpm build && pnpm parity:api && pnpm docs:check && pnpm size",
    "pack:all": "node tooling/scripts/pack-all.mjs",
    "pack:alpha": "node tooling/scripts/pack-all.mjs --base 0.1.0-alpha",
    "tarball:check": "node tooling/scripts/tarball-check.mjs",
    "integration:install": "node tooling/scripts/integration-install.mjs",
    "integration:test": "node tooling/scripts/integration-test.mjs",
    "dist:verify": "pnpm build && pnpm pack:all && pnpm tarball:check && pnpm integration:install && pnpm integration:test && pnpm scope:check"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@size-limit/esbuild": "14.3.0",
    "@size-limit/file": "14.3.0",
    "@tessen-ui/eslint-config": "workspace:*",
    "@tessen-ui/scripts": "workspace:*",
    "@tessen-ui/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "size-limit": "14.3.0",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
