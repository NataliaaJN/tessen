{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Manrope Variable",
          "Manrope",
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Interface text (brand UI font Manrope, system stack as fallback). The package does not ship font files."
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Code and technical labels."
      },
      "display": {
        "$value": ["Manrope Variable", "Inter", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Brand headlines. Optional: consumers are not required to load it."
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Authored in px, emitted as rem in CSS so text follows the font-size setting of the user.",
      "2xs": { "$value": { "value": 11, "unit": "px" } },
      "xs": { "$value": { "value": 12, "unit": "px" } },
      "sm": { "$value": { "value": 14, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 18, "unit": "px" } },
      "xl": { "$value": { "value": 20, "unit": "px" } },
      "2xl": { "$value": { "value": 24, "unit": "px" } },
      "3xl": { "$value": { "value": 30, "unit": "px" } },
      "4xl": { "$value": { "value": 36, "unit": "px" } },
      "5xl": { "$value": { "value": 48, "unit": "px" } },
      "6xl": { "$value": { "value": 60, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    },
    "letterSpacing": {
      "$type": "number",
      "$description": "Relative to the font size. DTCG dimensions only allow px and rem, so these are numbers with the unit declared in $extensions.tessen.unit.",
      "tight": { "$value": -0.01, "$extensions": { "tessen": { "unit": "em" } } },
      "normal": { "$value": 0, "$extensions": { "tessen": { "unit": "em" } } },
      "wide": { "$value": 0.02, "$extensions": { "tessen": { "unit": "em" } } },
      "caps": { "$value": 0.06, "$extensions": { "tessen": { "unit": "em" } } }
    }
  }
}
