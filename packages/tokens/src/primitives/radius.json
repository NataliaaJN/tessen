{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "radius": {
    "$type": "dimension",
    "$description": "Corner radii. Every step except none and full is derived from radius.base, so one slider reshapes the whole system.",
    "base": {
      "$value": { "value": 6, "unit": "px" },
      "$description": "Default control radius (the md step). The Theme Studio geometry control edits this value."
    },
    "none": { "$value": { "value": 0, "unit": "px" } },
    "xs": {
      "$value": { "value": 2, "unit": "px" },
      "$extensions": { "tessen": { "deriveFrom": "radius.base", "factor": "1/3" } }
    },
    "sm": {
      "$value": { "value": 4, "unit": "px" },
      "$extensions": { "tessen": { "deriveFrom": "radius.base", "factor": "2/3" } }
    },
    "md": {
      "$value": { "value": 6, "unit": "px" },
      "$extensions": { "tessen": { "deriveFrom": "radius.base", "factor": 1 } }
    },
    "lg": {
      "$value": { "value": 8, "unit": "px" },
      "$extensions": { "tessen": { "deriveFrom": "radius.base", "factor": "4/3" } }
    },
    "xl": {
      "$value": { "value": 12, "unit": "px" },
      "$extensions": { "tessen": { "deriveFrom": "radius.base", "factor": 2 } }
    },
    "2xl": {
      "$value": { "value": 16, "unit": "px" },
      "$extensions": { "tessen": { "deriveFrom": "radius.base", "factor": "8/3" } }
    },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "hairline": { "$value": { "value": 1, "unit": "px" } },
      "thick": { "$value": { "value": 2, "unit": "px" } },
      "focus": { "$value": { "value": 2, "unit": "px" } }
    }
  }
}
