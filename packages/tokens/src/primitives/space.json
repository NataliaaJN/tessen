{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale on a 4px base. Keys cannot contain dots, so 0.5 is written 0-5.",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "0-5": { "$value": { "value": 2, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "20": { "$value": { "value": 80, "unit": "px" } },
    "24": { "$value": { "value": 96, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$description": "Control heights. Interactive targets must stay at least 24x24px (WCAG 2.5.8); coarse pointers raise them to 44px in component CSS.",
      "sm": { "$value": { "value": 28, "unit": "px" } },
      "md": { "$value": { "value": 36, "unit": "px" } },
      "lg": { "$value": { "value": 44, "unit": "px" } }
    }
  }
}
