{
  "name": "@tessen-ui/react",
  "private": true,
  "version": "0.0.0",
  "description": "TESSEN for React: accessible components (Button, ...) on the shared contracts, styles and tokens.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tessen-ui/core": "workspace:*",
    "@zag-js/accordion": "1.48.0",
    "@zag-js/collection": "1.48.0",
    "@zag-js/combobox": "1.48.0",
    "@zag-js/dialog": "1.48.0",
    "@zag-js/menu": "1.48.0",
    "@zag-js/popover": "1.48.0",
    "@zag-js/select": "1.48.0",
    "@zag-js/slider": "1.48.0",
    "@zag-js/toast": "1.48.0",
    "@zag-js/presence": "1.48.0",
    "@zag-js/react": "1.48.0",
    "@zag-js/tabs": "1.48.0",
    "@zag-js/tooltip": "1.48.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
